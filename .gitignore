# Python/Django project .gitignore
# Virtual environment
venv/
# Byte‑compiled / optimized Python files
__pycache__/
*.py[cod]
*$py.class
# Django migrations (optional, keep if you track them)
# */migrations/
# IDE/editor directories
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
# OS generated files
.DS_Store
Thumbs.db
# Logs and temporary files
*.log
*.tmp
*.bak
# Environment files
.env
# Coverage reports
htmlcov/
.coverage
.coverage.*
# Pytest cache
.pytest_cache/
# Build artifacts
build/
Dist/
*.egg-info/
